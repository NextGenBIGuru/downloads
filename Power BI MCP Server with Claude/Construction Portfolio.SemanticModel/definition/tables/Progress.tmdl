table Progress
	lineageTag: d808558b-a630-41c5-8b01-dfc6a2464620

	column ProjectID
		dataType: string
		isHidden
		lineageTag: e8b4402e-03da-4c32-b796-ecb800362f84
		summarizeBy: none
		sourceColumn: ProjectID

	column MonthEnd
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 89ed6ec0-0e6b-4fdb-8ae0-9ab792f86d33
		summarizeBy: none
		sourceColumn: MonthEnd

		annotation UnderlyingDateTimeDataType = Date

	column PlannedPctComplete
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: de8a1be8-719d-4396-979a-1f3a70f6b928
		summarizeBy: none
		sourceColumn: PlannedPctComplete

	column ActualPctComplete
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: 6da599d3-f471-4666-b8ff-e1160a6e1ce3
		summarizeBy: none
		sourceColumn: ActualPctComplete

	partition Progress = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_progress.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"ProjectID", type text}, {"MonthEnd", type date}, {"PlannedPctComplete", type number}, {"ActualPctComplete", type number}}, "en-US")
				in
				    ChangedTypes

