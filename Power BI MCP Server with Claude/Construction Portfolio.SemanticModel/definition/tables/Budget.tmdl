table Budget
	lineageTag: 4a62a14a-3563-45b0-9944-196a044bf43e

	column ProjectID
		dataType: string
		isHidden
		lineageTag: fb66cca6-27ec-44e9-ac2f-2b7e927d99f3
		summarizeBy: none
		sourceColumn: ProjectID

	column CostCode
		dataType: string
		isHidden
		lineageTag: d3305050-bb89-45ac-8f60-b99d523bd47e
		summarizeBy: none
		sourceColumn: CostCode

	column BudgetAED
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: e2e20c9e-7c11-424a-9984-665f93d01933
		summarizeBy: none
		sourceColumn: BudgetAED

	partition Budget = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_budget.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"ProjectID", type text}, {"CostCode", type text}, {"BudgetAED", type number}}, "en-US")
				in
				    ChangedTypes

