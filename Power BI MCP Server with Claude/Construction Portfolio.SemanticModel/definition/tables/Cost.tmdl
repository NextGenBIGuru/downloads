	partition Cost = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_cost.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"TransactionID", type text}, {"PostingDate", type date}, {"ProjectID", type text}, {"CostCode", type text}, {"Vendor", type text}, {"CostType", type text}, {"AmountAED", type number}}, "en-US")
				in
				    ChangedTypes

