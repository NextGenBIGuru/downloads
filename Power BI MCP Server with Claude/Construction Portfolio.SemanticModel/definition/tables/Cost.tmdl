		lineageTag: 96c2b1a2-978f-4f60-a86f-ee9e55e4a75b
		summarizeBy: none
		sourceColumn: PostingDate

		annotation UnderlyingDateTimeDataType = Date

	column ProjectID
		dataType: string
		isHidden
		lineageTag: d3934bd1-be40-4258-a380-1c10abf69ab1
